ENCOUNTER_COMMON_IMPLING::
	lock
	faceplayer
	namebox ENCOUNTER_COMMON_IMPLING_Text_0
	playmoncry SPECIES_IMPLING_LUCKY_FORM, 0
	msgbox ENCOUNTER_COMMON_IMPLING_Text_1
	waitmoncry
	hidenamebox
	closemessage
	delay 1
	random 6
	switch VAR_RESULT
	case 1, ENCOUNTER_COMMON_IMPLING_3
	case 2, ENCOUNTER_COMMON_IMPLING_4
	case 3, ENCOUNTER_COMMON_IMPLING_5
	case 4, ENCOUNTER_COMMON_IMPLING_6
	case 5, ENCOUNTER_COMMON_IMPLING_7
	setwildbattle SPECIES_IMPLING_BABY_FORM, 30, ITEM_NONE
