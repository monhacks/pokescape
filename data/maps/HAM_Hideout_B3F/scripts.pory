mapscripts HAM_Hideout_B3F_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(HAMHIDEOUT_HEAL_ZONE)
    }
    MAP_SCRIPT_ON_TRANSITION {
        call(CHECK_JAILED_HAM)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_B, 1: HAM_WHITEOUT
    ]
}


script HAMHIDEOUT_HEAL_ZONE {
    setrespawn(HEAL_LOCATION_HAM_JAIL)
    end
}

script CHECK_JAILED_HAM {
    setflag(FLAG_TEMP_1F)

    switch (var(VAR_POKESCAPE_STORYMODE_PROGRESS)) {
        case 230:   //if you lose to that ham dude outside the jail
        case 235:
        case 240:
        case 241:
        case 245:
            checkfollower
            if (!var(VAR_RESULT)) {
                clearflag(FLAG_TEMP_1F) //Show Zanik
            }
    }

    if (var(VAR_POKESCAPE_STORYMODE_PROGRESS) == 235) {
        setobjectxy(2,8,7)
        setobjectxyperm(2,8,7)
    }
    if (flag(FLAG_HAM_JAILED) == TRUE) {
        setobjectxy(2,5,6)
        setobjectxyperm(2,5,6)
        setvar(VAR_TEMP_B, 1)
    }
    end
}

script HAM_WHITEOUT
{
    lock
    delay(60)
    namebox ("H.A.M Guard")
    applymovement(2, MOVEMENT_INTERACT_UP)
    msgbox(format("Stay here until we know what to do with you!"))
    waitmovement(0)
    closemessage
    hidenamebox
    applymovement(2, movement_HAM_lockup_leave)
    waitmovement(0)
    playse(SE_M_SNORE)
    namebox ("H.A.M Guard")
    msgbox(format("Zzz…"))
    switch (var(VAR_POKESCAPE_STORYMODE_PROGRESS)) {
        case 220:
        case 225:
        case 230:
        case 235:
        case 240:
        case 241:
        case 245: //Before you defeat Johanhus
            setflag(FLAG_TOGGLE_FORCED_WILD_DOUBLE_BATTLES)
            setflag(FLAG_PARTNER_BATTLE)
            setvar (VAR_PARTNER_TRAINER, TRAINER_ZANIK_HAM)
            setvar (VAR_PARTNER_SPRITE, TRAINER_BACK_PIC_ZANIK)
            loadword(0, Following_Zanik)
            setfollower(3, 0x80)
    }
    checkfollower
    if (var(VAR_RESULT)) {
        facefollower
        namebox ("Zanik")
        msgbox(format("This isn't good…\nWe must find a way out."))
        closemessage
        hidenamebox
    }
    setvar(VAR_TEMP_B, 2)
    setflag(FLAG_TEMP_10)
    clearflag(FLAG_HAM_JAILED)
    release
    end
}

movement movement_HAM_lockup_leave {
    walk_left * 2
    walk_down
    face_left
    step_end
}


script breakoutofHAM_jail_afterfailingtodefeatguard {
    applymovement(2, Movement_InteractFACERIGHT)
    waitmovement(0)
    namebox ("H.A.M Guard")
    msgbox(format("Huh?\pWhat?\pUrgh!\pStupid goblin how did you get out…\pI bet it was this human!\pThere's no way I'm letting either of you escape alive!"))
    hidenamebox
    closemessage
    //Runs off to sound the alarm.
    applymovement(2, Movement_Run_Right_5)
    waitmovement(0)
    playse(SE_DING_DONG)
    waitse
    applymovement(2, Movement_InteractFACELEFT)
    waitmovement(0)
    namebox ("H.A.M Guard")
    msgbox(format("Hahaha!"))
    hidenamebox
    closemessage
    playbgm(MUS_PS_HAM_HIDEOUT_HIGH_ALERT, TRUE)
    savebgm(MUS_PS_HAM_HIDEOUT_HIGH_ALERT)
    namebox ("Zanik")
    msgbox(format("Oh no they sounded the alarm!\pI'm sorry {PLAYER}…\pI should have just kept my mouth shut…"))
    hidenamebox
    closemessage
    //player interacts.
    applymovement(OBJ_EVENT_ID_FOLLOWER, Movement_InteractFACELEFT)
    applymovement(OBJ_EVENT_ID_PLAYER, MOVEMENT_INTERACT_RIGHT)
    waitmovement(0)
    namebox ("Zanik")
    msgbox(format("You're right, no time to feel sorry.\pWe've got some people to rescue!"))
    hidenamebox
    closemessage
    setvar(VAR_TEMP_0, 2)
    setvar(VAR_POKESCAPE_STORYMODE_PROGRESS, 235)
    clearflag(FLAG_HAM_HIDEOUT_DEFEATED_GUARDS_TO_LEAVE)
}

movement Movement_Run_Right_5 {
    walk_fast_right * 5
    step_end
}

script HAM_HIDEOUT_GATE
{
    if (var(VAR_TEMP_C) == 0) {
        lock
        msgbox(format("You attempt to pick the lock.\p…{PAUSE 15}…{PAUSE 15}…"))
        closemessage

        checkfollower
        if (var(VAR_RESULT)) {
            facefollower
            namebox ("Zanik")
            msgbox(format("Step aside {PLAYER} allow me."))
            closemessage
            hidenamebox
            //Zanik unlocks the door.
            //TODO: check where Zanik is standing to prevent any clipping. atm this assumes she is right behind you north and south
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_1) == 6) {
                applymovement(OBJ_EVENT_ID_PLAYER, HAM_Hideout_Player_Jail_Walk_Right)
                applymovement(OBJ_EVENT_ID_FOLLOWER, HAM_Hideout_Jail_Zanik_Walk_Up)
                waitmovement(0)
            }
            else {
                applymovement(OBJ_EVENT_ID_PLAYER, HAM_Hideout_Player_Jail_Walk_Right)
                applymovement(OBJ_EVENT_ID_FOLLOWER, movement_WALK_DOWN_1_STEP)
                waitmovement(0)
            }
            

            msgbox(format("Zanik attempts to pick the lock.\p…{PAUSE 15}…{PAUSE 15}…"))
            closemessage
            playse(SE_TRUCK_DOOR)
            msgbox(format("The door opens."))
            closemessage
        }
        else {
            playse(SE_TRUCK_DOOR)
            msgbox(format("The door opens."))
            closemessage
        }
        // set meta tiles open gate
        setmetatile(4, 4, METATILE_PokeScape_HAM_JAILDOOR_OPEN_TOP, 0)
        setmetatile(4, 5, METATILE_PokeScape_HAM_JAILDOOR_OPEN_BOTTOM, 1)
        setmetatile(5, 5, METATILE_PokeScape_HAM_HAM_CAVE_FLOOR, 0)
        setmetatile(5, 4, METATILE_PokeScape_HAM_HAM_CAVE_FLOOR, 0)
        setmetatile(6, 5, METATILE_PokeScape_HAM_JAILDOOR_OPEN_SIDE, 1)
        special(DrawWholeMapView) 

        checkfollower
        if (var(VAR_RESULT)) {
            facefollower
            namebox ("Zanik")
            msgbox(format("Easy-peasy, a high Thieving level comes in handy for situations like this, wouldn't you agree?\pLet's go!"))
            closemessage
            hidenamebox
        }
        setvar(VAR_TEMP_C, 1)
        if (var(VAR_POKESCAPE_STORYMODE_PROGRESS) == 230) {
            goto(breakoutofHAM_jail_afterfailingtodefeatguard)
        }
        release
    }
    end
}

script HAMHIDEOUT_Banker {
    lock
	faceplayer
    namebox ("Banker")
    msgbox(format("First the Black Knights, now H.A.M…\pIt seems I am destined for one thing only in life and that is to be a prisoner.\pThey didn't say you couldn't use the bank though, so how many I help you?"))
	waitmessage
    call(BANK_OPTIONS_JAIL)
    namebox ("Banker")
    msgbox(format("If you get out please tell my wife and children that I miss them…"))
    closemessage
    hidenamebox
    release
    end
}

script HAMHIDEOUT_BankChest {
    lock
    msgbox(format("Would you like to use the bank chest?"))
	waitmessage
    call(BANK_OPTIONS_JAIL)
    closemessage
    release
    end
}

script HAMHIDEOUT_Guard {
    lock
    if (var(VAR_TEMP_0) == 2) {
        faceplayer
        namebox ("H.A.M Guard")
        msgbox(format("I've sounded the alarm!\pYou both won't be getting away now!"))
    }
    elif (flag(FLAG_TEMP_10)) {
        faceplayer
        namebox ("H.A.M Guard")
        msgbox(format("Zzz…{PAUSE 15}…\pHuh?!{PAUSE 15} What?!\nHow did you get out!?\pI've sounded the alarm!\pYou both won't be getting away now!"))
    }
    elif (var(VAR_POKESCAPE_STORYMODE_PROGRESS) == 235) {
        faceplayer
        namebox ("H.A.M Guard")
        msgbox(format("I've sounded the alarm!\pYou both won't be getting away now!"))
    }
    else {
        namebox ("H.A.M Guard")
        playse(SE_M_SNORE)
        msgbox(format("Zzz…"))
    }
    hidenamebox
    closemessage
    release
    end
    
}
