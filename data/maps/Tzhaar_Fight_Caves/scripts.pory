            setvar(VAR_TEMP_F, OBJ_EVENT_ID_TZKIH_1) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_3) 
            addobject(OBJ_EVENT_ID_TZKIH_1)
            clearflag(FLAG_TEMP_1)
