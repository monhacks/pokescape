mapscripts Tzhaar_Fight_Caves_MapScripts {
    MAP_SCRIPT_ON_TRANSITION 
    {
        call(TZHAAR_FIGHTCAVES_STATE)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_D, 0: FIGHTCAVES_CHALLENGE_START
    ]
}

script TZHAAR_FIGHTCAVES_STATE {
    setflag(FLAG_TEMP_1)
    setflag(FLAG_TEMP_2)
    setflag(FLAG_TEMP_3)
    setflag(FLAG_TEMP_4)
    setflag(FLAG_TEMP_5)
    setflag(FLAG_TEMP_6)
    setflag(FLAG_TEMP_7)
    setflag(FLAG_TEMP_8)
    setflag(FLAG_TEMP_9)
    setflag(FLAG_TEMP_10)
    setflag(FLAG_TEMP_11)
    setflag(FLAG_TEMP_12)
    setflag(FLAG_TEMP_13)
    setflag(FLAG_TEMP_14)
    setflag(FLAG_TEMP_15)
    setflag(FLAG_TEMP_16)
    setflag(FLAG_TEMP_17)
    setflag(FLAG_TEMP_18)
    setflag(FLAG_TEMP_19)
    setflag(FLAG_TEMP_A)
    removeobject(OBJ_EVENT_ID_TZKIH_1)
    removeobject(OBJ_EVENT_ID_TZKIH_2)
    removeobject(OBJ_EVENT_ID_TZKIH_3)
    removeobject(OBJ_EVENT_ID_GAAL_4)
    removeobject(OBJ_EVENT_ID_GAAL_5)
    removeobject(OBJ_EVENT_ID_KET_6)
    removeobject(OBJ_EVENT_ID_KET_7)
    removeobject(OBJ_EVENT_ID_KEK_8)
    removeobject(OBJ_EVENT_ID_KEK_9)
    removeobject(OBJ_EVENT_ID_KET_HD_10)
    removeobject(OBJ_EVENT_ID_KET_HD_11)
    removeobject(OBJ_EVENT_ID_KETDILL_12)
    removeobject(OBJ_EVENT_ID_TOKXIL_13)
    removeobject(OBJ_EVENT_ID_YTHURKOT_14)
    removeobject(OBJ_EVENT_ID_YTHURKOT_15)
    removeobject(OBJ_EVENT_ID_CHAMPION_16)
    removeobject(OBJ_EVENT_ID_TZTOKJAD_17)
    removeobject(OBJ_EVENT_ID_TZHAAR_FANBOY)
    removeobject(OBJ_EVENT_ID_YTHURKOT_HEALER_19)
    removeobject(OBJ_EVENT_ID_ROCKPILE_20)
}

script FIGHTCAVES_ENTER {
    msgbox(format("Would you like to start your challenge?"), MSGBOX_YESNO)
    if (var(VAR_RESULT))
    {
        msgbox(format("Good luck JalYt!"))
        closemessage
        hidenamebox
        // player walks into the cave.
        //applymovement(OBJ_EVENT_ID_PLAYER, Movement_InteractFACEDOWN)
        //waitmovement(0)
        call(FIGHTCAVES_SETUP_BEGIN)
        return
    }
    goto(TZHAAR_FIGHTCAVES_NPC)
}

script FIGHTCAVES_SETUP_BEGIN {
    call(FIGHT_CAVES_RESTRICTIONS_ON)
    setrespawn(HEAL_LOCATION_TZHAAR_GYM_ROOM)
    warp(MAP_TZHAAR_FIGHT_CAVES, 0)
    waitstate
}

script TRIGGER_FIGHT_CAVES_QUIT {
    lockall
    msgbox(format("Would you like to quit your challenge?"), MSGBOX_YESNO)
    if (var(VAR_RESULT))
    {
        msgbox(format("WARNING: You will lose your progress and have to start from the beginning.\pAre you sure you would you like to quit your challenge?"), MSGBOX_YESNO)
        if (var(VAR_RESULT))
        {
            closemessage
            call(FIGHT_CAVES_RESTRICTIONS_OFF)
            setvar(VAR_TZHAAR_CHALLENGES_STATUS, 5)
            warp(MAP_MOR_UL_REK, 4)
            waitstate
        }
    }
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, movement_lock_walk_up)
    waitmovement(0)
    releaseall
    end
}

script FIGHTCAVES_CHALLENGE_START {
    setvar(VAR_TEMP_D, 1)
    applymovement(OBJ_EVENT_ID_PLAYER, ENTER_FIGHT_CAVES)
    waitmovement(0)
    call(TZHAAR_FIGHTCAVES_WAVES_CONTROL)
    release
    end
}



//SPAWN LOCATION--------------------------------------------------------------------
script FIGHTCAVES_SET_SPAWN_LOCATION_1 {
    random(5) 
	switch (var(VAR_RESULT)) { 
        case 0: 
            setobjectxyperm(VAR_TEMP_F, 5, 11)
        case 1: 
            setobjectxyperm(VAR_TEMP_F, 20, 6)
        case 2: 
            setobjectxyperm(VAR_TEMP_F, 19, 24)
        case 3:    
            setobjectxyperm(VAR_TEMP_F, 6, 26)
        case 4:    
            setobjectxyperm(VAR_TEMP_F, 6, 26)
        case 5:    
            setobjectxyperm(VAR_TEMP_F, 6, 26)
    } 
    return
}
script FIGHTCAVES_SET_SPAWN_LOCATION_2 {
    random(4) 
	switch (var(VAR_RESULT)) { 
