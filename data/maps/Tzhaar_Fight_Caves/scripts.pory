            call(FIGHTCAVES_WAVE_TRANSITION_START)
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_KET_6) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_1) 
            addobject(OBJ_EVENT_ID_KET_6) 
            clearflag(FLAG_TEMP_6)
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_TOKXIL_13) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_2)
            addobject(OBJ_EVENT_ID_TOKXIL_13)
            clearflag(FLAG_TEMP_13)
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_KETDILL_12) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_3) 
            addobject(OBJ_EVENT_ID_KETDILL_12) 
            clearflag(FLAG_TEMP_12)
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_YTHURKOT_14) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_4) 
            addobject(OBJ_EVENT_ID_YTHURKOT_14) 
            clearflag(FLAG_TEMP_14)
            call(FIGHTCAVES_WAVE_TRANSITION_END)
        case 49: //begin WAVE 25
            setvar(VAR_TEMP_E, 25) //WAVE: 25
            call(FIGHTCAVES_WAVE_TRANSITION_START)
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_TZTOKJAD_17) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_SPECIAL) 
            addobject(OBJ_EVENT_ID_TZTOKJAD_17)
            clearflag(FLAG_TEMP_17)
            call(FIGHTCAVES_WAVE_TRANSITION_END)
        case 50: //begin WAVE 25
            setvar(VAR_TZHAAR_CHALLENGES_STATUS, 10) // Completed the Fight Caves.
            call(FIGHT_CAVES_RESTRICTIONS_OFF)
            warp(MAP_MOR_UL_REK, 4)
            waitstate
            release
            end
    }
}
//--------------------------------------------------------------------

script FIGHTCAVES_RANDOM_EVENT {
    random(3)
    switch(var(VAR_RESULT)){
        case 0: 
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_TZHAAR_FANBOY) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_SPECIAL)
            addobject(OBJ_EVENT_ID_TZHAAR_FANBOY) 
            clearflag(FLAG_TEMP_18)
        case 1: 
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_YTHURKOT_HEALER_19) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_SPECIAL) 
            addobject(OBJ_EVENT_ID_YTHURKOT_HEALER_19) 
            clearflag(FLAG_TEMP_19)
        case 2: 
            setvar(VAR_TEMP_F, OBJ_EVENT_ID_ROCKPILE_20) //OBJECT TO SPAWN.
            call(FIGHTCAVES_SET_SPAWN_LOCATION_SPECIAL) 
            addobject(OBJ_EVENT_ID_ROCKPILE_20) 
            clearflag(FLAG_TEMP_A)
    }
    return
}









