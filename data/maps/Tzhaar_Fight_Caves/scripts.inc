FIGHTCAVES_ENTER::
	msgbox FIGHTCAVES_ENTER_Text_0
	closemessage
	hidenamebox
	call FIGHTCAVES_SETUP_BEGIN
	return


FIGHTCAVES_SETUP_BEGIN::
	call FIGHT_CAVES_RESTRICTIONS_ON
	setrespawn HEAL_LOCATION_TZHAAR_GYM_ROOM
	warp MAP_TZHAAR_FIGHT_CAVES, 0
	waitstate
	return


TRIGGER_FIGHT_CAVES_QUIT::
	lockall
	msgbox TRIGGER_FIGHT_CAVES_QUIT_Text_0, MSGBOX_YESNO
	compare VAR_RESULT, 0
	goto_if_ne TRIGGER_FIGHT_CAVES_QUIT_2
TRIGGER_FIGHT_CAVES_QUIT_1:
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, movement_lock_walk_up
	waitmovement 0
	releaseall
	end

TRIGGER_FIGHT_CAVES_QUIT_2:
	msgbox TRIGGER_FIGHT_CAVES_QUIT_Text_1, MSGBOX_YESNO
	compare VAR_RESULT, 0
	goto_if_ne TRIGGER_FIGHT_CAVES_QUIT_4
	goto TRIGGER_FIGHT_CAVES_QUIT_1

TRIGGER_FIGHT_CAVES_QUIT_4:
	closemessage
	call FIGHT_CAVES_RESTRICTIONS_OFF
	setvar VAR_TZHAAR_CHALLENGES_STATUS, 5
	warp MAP_MOR_UL_REK, 4
	waitstate
	goto TRIGGER_FIGHT_CAVES_QUIT_1


FIGHTCAVES_CHALLENGE_START::
	setvar VAR_TEMP_D, 1
	applymovement OBJ_EVENT_ID_PLAYER, ENTER_FIGHT_CAVES
	waitmovement 0
	call TZHAAR_FIGHTCAVES_WAVES_CONTROL
	release
	end


