script AskMaggieForABattle {
    msgbox(format("Hiya!\nMy name is Maggie.\pSay cha looks pretty strong, care for a battle?"), MSGBOX_YESNO)
    if (!var(VAR_RESULT))
    { 
		msgbox(format("That's anything but sweet of cha…"))
        closemessage
		release
    	end
	}
    return
}

script MaggieDoesntHaveABattle {
    msgbox(format("Oh, Hi!\nIt's cha again!\pAnother battle?\pMaybe once you've grown a bit more."))
    closemessage
    release
    end
}

