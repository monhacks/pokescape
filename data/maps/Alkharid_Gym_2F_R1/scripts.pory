mapscripts Alkharid_Gym_2F_R1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_EVOLUTION_MAP_STATE, 11) //MAP LOCATIONS: 0-NOTHING, 1-LUMBRIDGE, 16-VARROCK, 3-FALADOR, 4-MEMBERS, 5-OCEAN, 6-WILDERNESS, 7-MORYTANIA, 8-CAVES, 9-ABYSS, 10-OFFWORLD, 11-DESERT, 15-KARAMJA
        call(ALKHARID_GYM_ROOMS_STATE)
        call(ALKHARID_GYM_NPCS_POST_GYM_2F_1R)
    }
}

script ALKHARID_GYM_NPCS_POST_GYM_2F_1R {
	switch (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)){ 
        case 0:
            setobjectxyperm(2, 10, 5)
			setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT)
        case 30: //GYM DEFEATED
            setobjectxyperm(2, 10, 5)
			setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT)
            setobjectxyperm(3, 6, 3)
			setobjectmovementtype(3, MOVEMENT_TYPE_WANDER_AROUND)
    }
    return
}





script GYM_NPC_5
{
    lock
    faceplayer
    if (flag(FLAG_ALKHARIDGYM_3) == FALSE)
		{	
            if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==15) { //If Gym Challenge.
                call(CHECK_IF_ALI)
                if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==20) {
                    msgbox(format("Guards help me as I make my escape!"))
                    hidenamebox
                    closemessage
                    applymovement(VAR_LAST_TALKED, Movement_AlkharidGym_TELEPORT)
                    delay(30)
                    removeobject(VAR_LAST_TALKED)
                    addobject(1) // extra guard
                    clearflag(FLAG_TEMP_6)
                    call(GYM_MOVEMENT_FOUND_ALI_NPC5)
                    waitmovement(0)
                    namebox("Warrior")
                    msgbox(format("Brother, I will help thee with this infidel!"))
                    hidenamebox
                    closemessage
                    trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_3, format("Consider that a warning!") )
                    if (var(VAR_RESULT) == B_OUTCOME_LOST) { //
                        setvar(VAR_POKESCAPE_ALKHARID_GYM_QUEST, 0)
                        end
                    }
                    namebox("Warrior")
                    msgbox(format("You have defeated us!\pBut the Prince has made his escape so we have done our jobs."))
                    closemessage
                    hidenamebox
                    applymovement(3, MOVEMENT_WALK_LEFT)
                    waitmovement(0)
                    applymovement(3, MOVEMENT_FACE_RIGHT)
                    waitmovement(0)
                    release
                    end
                }
                call(GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC5)
                namebox("Warrior")
                msgbox(format("Brother, I will help thee with this infidel!"))
                hidenamebox
                closemessage
                trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_3, format("Consider that a warning!") )
                namebox("Warrior")
                msgbox(format("You have defeated us!\pBut the Prince is still somewhere around the Palace."))
                closemessage
                hidenamebox
                setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(3, MOVEMENT_TYPE_WANDER_AROUND)
                setflag(FLAG_ALKHARIDGYM_3)
                release
                end
            }
        }
    if (flag(FLAG_BADGE06_GET)) { //If Gym badge is obtained.   //ALKHARID BADGE
        namebox("Warrior")
        msgbox(format("Have you heard of our lord and savior Tumeken and Elindis?"))
        release
        end
    }
    if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==0) { // If Gym challenge hasnt been started.
        namebox("Warrior")
        msgbox(format("Do you think you have what it takes to defeat Al Kharid's elite fighting force?"))
    }
    else {
        namebox("Warrior")
        msgbox(format("My prince has fled the scene!\pJust as we planned!"))
    }
    closemessage
    release
    end
}
script GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC5 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 5: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_1)
        case 6: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_2)
    }
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_1 {
    walk_faster_down
    walk_faster_left * 4
    walk_faster_down * 2
    step_end
}
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_2 {
    walk_faster_down
    walk_faster_left * 3
    walk_faster_down * 3
    step_end
}

script GYM_MOVEMENT_FOUND_ALI_NPC5 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 5: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_1)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC5_1)
        case 6: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC5_2)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC5_2)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, MOVEMENT_FACE_UP)
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC5_1
{
    walk_faster_left * 10
    walk_faster_down * 2
    walk_faster_left * 1
    step_end
} 
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC5_2
{
    walk_faster_left * 10
    walk_faster_down * 3
    face_left
    step_end
} 





script GYM_NPC_6
{
    lock
    if (flag(FLAG_ALKHARIDGYM_3) == FALSE)
		{	
            if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==15) { //If Gym Challenge.
                faceplayer
                call(CHECK_IF_ALI)
                if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==20) {
                    msgbox(format("Guards help me as I make my escape!"))
                    hidenamebox
                    closemessage
                    applymovement(VAR_LAST_TALKED, Movement_AlkharidGym_TELEPORT)
                    delay(30)
                    removeobject(VAR_LAST_TALKED)
                    addobject(1) // extra guard
                    clearflag(FLAG_TEMP_6)
                    call(GYM_MOVEMENT_FOUND_ALI_NPC6)
                    namebox("Warrior")
                    msgbox(format("Brother, I will help thee with this infidel!"))
                    hidenamebox
                    closemessage
                    trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_3, format("Consider that a warning!") )
                    if (var(VAR_RESULT) == B_OUTCOME_LOST) { //
                        setvar(VAR_POKESCAPE_ALKHARID_GYM_QUEST, 0)
                        end
                    }
                    namebox("Warrior")
                    msgbox(format("You have defeated us!\pBut the Prince has made his escape so we have done our jobs."))
                    closemessage
                    hidenamebox
                    applymovement(1, MOVEMENT_WALK_DOWN)
                    waitmovement(0)
                    applymovement(1, MOVEMENT_FACE_UP)
                    waitmovement(0)
                    release
                    end
                }
                call(GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC6)
                namebox("Warrior")
                msgbox(format("Brother, I will help thee with this infidel!"))
                hidenamebox
                closemessage
                trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_3, format("Consider that a warning!") )
                namebox("Warrior")
                msgbox(format("You have defeated us!\pBut the Prince is still somewhere around the Palace."))
                closemessage
                hidenamebox
                setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(3, MOVEMENT_TYPE_WANDER_AROUND)
                setflag(FLAG_ALKHARIDGYM_3)
                release
                end
            }
        }
    if (flag(FLAG_BADGE06_GET)) { //If Gym badge is obtained.   //ALKHARID BADGE
        faceplayer
        namebox("Warrior")
        msgbox(format("Have you ever wondered who drew that tastyful picture upon the wall?\pI believe it was an artist called Mod Blkwitch.\pI swear it has some magical power over me everytime I look at it though…"))
        release
        end
    }
    if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==0) { // If Gym challenge hasnt been started.
        namebox("Warrior")
        msgbox(format("My, this picture…\pI feel so many things from it…\pHail lord Zam…"))
        faceplayer
        namebox("Warrior")
        msgbox(format("Huh?\pWhat was I saying!?\pPrince Ali is the only man for me."))
        turnobject(VAR_LAST_TALKED, DIR_NORTH)
    }
    else {
        faceplayer
        namebox("Warrior")
        msgbox(format("My brothers, have you seen this picture yet?"))
    }
    closemessage
    release
    end
}
script GYM_MOVEMENT_FOUND_ALI_NPC6 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 8: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC6_1)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_1)
        case 9: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC6_2)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_2)
        case 10: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC6_3)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_3)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, MOVEMENT_FACE_DOWN)
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_1
{
    walk_faster_left * 8
    walk_faster_up * 2
    face_left
    step_end
} 
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_2
{
    walk_faster_left * 7
    walk_faster_up * 1
    face_left
    step_end
} 
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC6_3
{
    walk_faster_left * 8
    walk_faster_up * 2
    face_right    
    step_end
} 
