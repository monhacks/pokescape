

mapscripts Alkharid_Gym_1F_R3_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_EVOLUTION_MAP_STATE, 11) //MAP LOCATIONS: 0-NOTHING, 1-LUMBRIDGE, 16-VARROCK, 3-FALADOR, 4-MEMBERS, 5-OCEAN, 6-WILDERNESS, 7-MORYTANIA, 8-CAVES, 9-ABYSS, 10-OFFWORLD, 11-DESERT, 15-KARAMJA
        call(ALKHARID_GYM_ROOMS_STATE)
        call(ALKHARID_GYM_NPCS_POST_GYM_1F_3R)
    }
}

script ALKHARID_GYM_NPCS_POST_GYM_1F_3R{
	switch (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)){ 
        case 0:
            setobjectxyperm(2, 8, 2)
			setobjectmovementtype(2, MOVEMENT_TYPE_FACE_UP)
        case 30: //GYM DEFEATED
            setobjectxyperm(2, 9, 7)
			setobjectmovementtype(2, MOVEMENT_TYPE_FACE_LEFT)
    }
    return
}








script ALKHARID_GYM_ROOMS_STATE{
	switch (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)){ 
		case 0: 
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)
        case 5: 
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)   
        case 10:
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)
        case 15:
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)
        case 20:
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)
        case 30: //GYM DEFEATED
            removeobject(1) // extra guard
            setflag(FLAG_TEMP_6)
    }
    return
}







//NPCS


script GYM_NPC_1
{
    lock
    faceplayer
    if (flag(FLAG_ALKHARIDGYM_1) == FALSE)
		{	
            if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==15) { //If Gym Challenge.
                call(CHECK_IF_ALI)
                if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==20) {
                    msgbox(format("Guards help me as I make my escape!"))
                    hidenamebox
                    closemessage
                    applymovement(VAR_LAST_TALKED, Movement_AlkharidGym_TELEPORT)
                    delay(30)
                    removeobject(VAR_LAST_TALKED)
                    addobject(1) // extra guard
                    clearflag(FLAG_TEMP_6)
                    call(GYM_MOVEMENT_FOUND_ALI_NPC1)
                    namebox("Warrior")
                    msgbox(format("Brother, I will help thee with this infidel!"))
                    hidenamebox
                    closemessage
                    trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_1, format("Consider that a warning!") )
                    if (var(VAR_RESULT) == B_OUTCOME_LOST) { //
                        setvar(VAR_POKESCAPE_ALKHARID_GYM_QUEST, 0)
                        end
                    }
                    namebox("Warrior")
                    msgbox(format("You have defeated us!\pBut the Prince has made his escape so we have done our jobs."))
                    closemessage
                    hidenamebox
                    applymovement(1, MOVEMENT_WALK_DOWN)
                    waitmovement(0)
                    applymovement(1, MOVEMENT_FACE_UP)
                    waitmovement(0)
                    release
                    end
                }
                call(GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC1)
                namebox("Warrior")
                msgbox(format("Brother, I will help thee with this infidel!"))
                hidenamebox
                closemessage
                trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_1, format("Consider that a warning!") )
                namebox("Warrior")
                msgbox(format("You have defeated us!\pBut the Prince is still somewhere around the Palace."))
                closemessage
                hidenamebox
                setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(3, MOVEMENT_TYPE_WANDER_AROUND)
                setflag(FLAG_ALKHARIDGYM_1)
                release
                end
            }
        }
    if (flag(FLAG_BADGE06_GET)) { //If Gym badge is obtained.   //ALKHARID BADGE
        namebox("Warrior")
        msgbox(format("The other day a Magicarpet flew out from underneath my feet!\pI thought it was just a regular carpet…"))
        release
        end
    }
    if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==0) { // If Gym challenge hasnt been started.
        namebox("Warrior")
        msgbox(format("Greetings, if you wish to take up the challenge of the AlKharid Gym, then speak with Osman in the throne room."))
    }
    else {
        namebox("Warrior")
        msgbox(format("I will continue to protect the prince forever!"))
    }
    closemessage
    release
    end
}
script GYM_MOVEMENT_FOUND_ALI_NPC1 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 1: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_1)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC1_1)
        case 2: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_2)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC1_2)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, MOVEMENT_FACE_DOWN)
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC1_1
{
    walk_faster_left * 4
    walk_faster_down
    walk_faster_left * 5
    face_up
    step_end
} 
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC1_2
{
    walk_faster_left * 8
    face_down
    step_end
} 
script GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC1 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 1: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_1)
        case 2: 
            applymovement(3, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_2)
    }
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_1
{
    walk_faster_up
    walk_faster_left * 4
    walk_faster_up
    face_left
    step_end
} 
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC1_2
{
    walk_faster_up
    walk_faster_left * 3
    step_end
}












script GYM_NPC_2
{
    lock
    faceplayer
    if (flag(FLAG_ALKHARIDGYM_1) == FALSE)
		{	
            if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==15) { //If Gym Challenge.
                call(CHECK_IF_ALI)
                if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==20) {
                    msgbox(format("Guards help me as I make my escape!"))
                    hidenamebox
                    closemessage
                    applymovement(VAR_LAST_TALKED, Movement_AlkharidGym_TELEPORT)
                    delay(30)
                    removeobject(VAR_LAST_TALKED)
                    addobject(1) // extra guard
                    clearflag(FLAG_TEMP_6)
                    call(GYM_MOVEMENT_FOUND_ALI_NPC2)
                    namebox("Warrior")
                    msgbox(format("Brother, I will help thee with this infidel!"))
                    hidenamebox
                    closemessage
                    trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_1, format("Consider that a warning!") )
                    if (var(VAR_RESULT) == B_OUTCOME_LOST) { //
                        setvar(VAR_POKESCAPE_ALKHARID_GYM_QUEST, 0)
                        end
                    }
                    namebox("Warrior")
                    msgbox(format("You have defeated us!\pBut the Prince has made his escape so we have done our jobs."))
                    closemessage
                    hidenamebox
                    applymovement(2, Movement_AlkharidGym_moveafterbattle_1)
                    applymovement(1, Movement_AlkharidGym_moveafterbattle_2)
                    waitmovement(0)
                    release
                    end
                }
                call(GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC2)
                namebox("Warrior")
                msgbox(format("Brother, I will help thee with this infidel!"))
                hidenamebox
                closemessage
                trainerbattle_no_intro(TRAINER_ALKHARID_GYM_TRAINER_1, format("Consider that a warning!") )
                namebox("Warrior")
                msgbox(format("You have defeated us!\pBut the Prince is still somewhere around the Palace."))
                closemessage
                hidenamebox
                setflag(FLAG_ALKHARIDGYM_1)
                applymovement(2, Movement_AlkharidGym_moveafterbattle_1)
                waitmovement(0)
                setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(2, MOVEMENT_TYPE_WANDER_AROUND)
                setobjectmovementtype(3, MOVEMENT_TYPE_WANDER_AROUND)
                release
                end
            }
        }
    if (flag(FLAG_BADGE06_GET)) { //If Gym badge is obtained.   //ALKHARID BADGE
        namebox("Warrior")
        msgbox(format("Vultures are the best monsters to train, wouldn't you agree?"))
        release
        end
    }
    if (var(VAR_POKESCAPE_ALKHARID_GYM_QUEST)==0) { // If Gym challenge hasnt been started.
        namebox("Warrior")
        msgbox(format("Are you are gym challenger?\pSpeak to Osman in the throne room."))
    }
    else {
        namebox("Warrior")
        msgbox(format("We defend our brothers like they are family.\pBecause they are our family."))
    }
    closemessage
    release
    end
}
script GYM_MOVEMENT_FOUND_ALI_NPC2 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 5: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_1)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC2_1)
        case 6: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_2)
            applymovement(1, Movement_AlkharidGym_FOUND_ALI_ALI_NPC2_2)
    }
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, MOVEMENT_FACE_DOWN)
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC2_1
{
    walk_faster_left * 5
    walk_faster_down
    step_end
} 
movement Movement_AlkharidGym_FOUND_ALI_ALI_NPC2_2
{
    walk_faster_left * 4
    face_down
    step_end
} 
script GYM_MOVEMENT_DID_NOT_FIND_ALI_NPC2 {
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch (var(VAR_TEMP_1)) { 
        case 5: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_1)
        case 6: 
            applymovement(2, Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_2)
    }
    waitmovement(0)
    return
}
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_1
{
    walk_faster_right
    walk_faster_down
    walk_faster_right * 2
    face_left
    step_end
} 
movement Movement_AlkharidGym_DID_NOT_FIND_ALI_NPC2_2
{
    walk_faster_right * 4
    step_end
}








